rules_version = '2'; service firebase.storage { match /b/{bucket}/o { function signedIn(){return request.auth!=null;} match /product_images/{uid}/{allPaths=**}{allow read:if true;allow write:if signedIn()&&request.auth.uid==uid&&request.resource.size<10*1024*1024;} match /chat_images/{chatId}/{allPaths=**}{allow read,write:if signedIn()&&request.resource.size<10*1024*1024;} } }