rules_version = '2';
service cloud.firestore { match /databases/{database}/documents {
function signedIn(){return request.auth!=null;} function admin(){return signedIn()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='admin';}
match /users/{uid}{allow read,create:if signedIn()&&request.auth.uid==uid;allow update:if signedIn()&&request.auth.uid==uid&&request.resource.data.role==resource.data.role;}
match /wallets/{uid}{allow read:if signedIn()&&request.auth.uid==uid;allow write:if false;}
match /coin_transactions/{id}{allow read:if signedIn()&&resource.data.userId==request.auth.uid||admin();allow write:if false;}
match /products/{id}{allow read:if true;allow create:if signedIn()&&request.resource.data.sellerId==request.auth.uid;allow update:if signedIn()&&(resource.data.sellerId==request.auth.uid||admin());allow delete:if admin();}
match /chats/{id}{allow read,create,update:if signedIn();}
match /chats/{chatId}/messages/{messageId}{allow read,create:if signedIn();allow update,delete:if false;}
match /banners/{id}{allow read:if true;allow write:if admin();}
} }