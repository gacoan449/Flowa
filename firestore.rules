rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function admin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && (request.auth.uid == userId || admin());
      allow delete: if admin();
    }
    match /users/{userId}/favorites/{doc} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
    match /users/{userId}/devices/{doc} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /products/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if signedIn()
        && (resource.data.sellerId == request.auth.uid || admin());
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /banners/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if admin();
    }
    match /app_config/{docId} {
      allow read: if true;
      allow write: if admin();
    }
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if admin();
      allow delete: if false;
    }

    // Profil chat hanya memuat nama/foto/status; email dan data privat tetap di users.
    match /public_profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoUrl', 'isOnline', 'lastSeen', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow read, update: if signedIn()
        && request.auth.uid in resource.data.participants
        && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        function chatData() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function isParticipant() {
          return signedIn() && request.auth.uid in chatData().participants;
        }
        allow read: if isParticipant();
        allow create: if isParticipant()
          && chatData().get('blockedBy', []).size() == 0
          && request.resource.data.senderId == request.auth.uid
          && (
            (request.resource.data.text is string && request.resource.data.text.size() > 0)
            || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.size() > 0)
          );
        allow update: if isParticipant()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deliveredTo', 'readBy', 'reactions', 'updatedAt'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['readBy'])
            || request.auth.uid in request.resource.data.readBy
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveredTo'])
            || request.auth.uid in request.resource.data.deliveredTo
          );
        allow delete: if false;
      }
    }

    match /user_blocks/{blockId} {
      allow read: if signedIn() && resource.data.blockerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid;
      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    match /support_threads/{threadId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || admin());
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || admin());
      match /messages/{messageId} {
        function canUseThread() {
          return signedIn()
            && (get(/databases/$(database)/documents/support_threads/$(threadId)).data.userId == request.auth.uid || admin());
        }
        allow read: if canUseThread();
        allow create: if canUseThread() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
