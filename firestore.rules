rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==============================
    // FUNGSI KEAMANAN DASAR
    // ==============================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == 'flowa324@gmail.com'
          || request.auth.token.admin == true
          || request.auth.token.role == 'admin'
        );
    }

    function hasPermission(permission) {
      return isAdmin()
        || (signedIn()
          && request.auth.token.permissions is list
          && permission in request.auth.token.permissions);
    }

    function platformEnabled(flag) {
      let configPath = /databases/$(database)/documents/app_config/platform;
      return !exists(configPath)
        || get(configPath).data.get(flag, true) == true;
    }

    function maintenanceIsOff() {
      let configPath = /databases/$(database)/documents/app_config/platform;
      return !exists(configPath)
        || get(configPath).data.get('maintenanceMode', false) == false;
    }

    // ==============================
    // USERS / PROFIL PRIVAT
    // ==============================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user';

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'photoUrl', 'location', 'bio',
            'prefNotifications', 'prefShowOnline', 'prefShowActivity', 'updatedAt'
          ])
        );

      allow delete: if isAdmin();

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }

      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ==============================
    // PROFIL PUBLIK UNTUK CHAT
    // Email dan data privat tidak disimpan di sini.
    // ==============================

    match /public_profiles/{userId} {
      allow read: if signedIn();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'bio', 'photoUrl',
          'isOnline', 'lastSeen', 'updatedAt'
        ]);

      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'bio', 'photoUrl',
          'isOnline', 'lastSeen', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // ==============================
    // PRODUK / IKLAN MARKETPLACE
    // ==============================

    match /products/{productId} {
      allow read: if true;

      allow create: if signedIn()
        && platformEnabled('adsEnabled')
        && platformEnabled('uploadEnabled')
        && maintenanceIsOff()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.price is number
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && !(request.resource.data.latitude == 0
          && request.resource.data.longitude == 0);

      allow update: if isAdmin()
        || (
          hasPermission('marketplace')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'moderatedAt', 'updatedAt'])
          && request.resource.data.status in ['active', 'inactive']
        )
        || (
          signedIn()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'price', 'imageUrl', 'imageUrls',
            'category', 'locationName', 'brand', 'condition', 'stock',
            'isNegotiable', 'deliveryOptions', 'warranty',
            'status', 'updatedAt'
          ])
        )
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'stock', 'status', 'lastOrderId', 'updatedAt'
          ])
          && request.resource.data.lastOrderId is string
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.buyerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.productId == productId
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.sellerId == resource.data.sellerId
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)).data.quantity == resource.data.stock - request.resource.data.stock
          && request.resource.data.status == (request.resource.data.stock == 0 ? 'sold_out' : 'active')
        )
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'reportCount'
          ])
          && request.resource.data.get('reportCount', 0)
            == resource.data.get('reportCount', 0) + 1
        );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.sellerId == request.auth.uid);
    }

    // ==============================
    // KATEGORI, BANNER, PENGUMUMAN
    // ==============================

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if hasPermission('content');
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if hasPermission('content');
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if hasPermission('content');
    }

    match /app_config/{configId} {
      allow read: if true;
      allow write: if configId == 'platform'
        ? hasPermission('system')
        : (hasPermission('content') || hasPermission('system'));
    }

    // ==============================
    // LAPORAN IKLAN / PENGGUNA
    // ==============================

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && (
          request.resource.data.get('productId', '') is string
          || (
            request.resource.data.get('targetUserId', '') is string
            && request.resource.data.get('chatId', '') is string
          )
        );

      allow read, update: if hasPermission('reports');
      allow delete: if false;
    }

    // ==============================
    // CHAT PEMBELI - PENJUAL
    // ==============================

    match /chats/{chatId} {

      function isParticipant() {
        return signedIn()
          && request.auth.uid in resource.data.participants;
      }

      // Jika typing map berubah, pengguna hanya boleh mengubah status miliknya.
      function typingUpdateIsOwn() {
        return !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['typing'])
          || request.resource.data.get('typing', {}).diff(
              resource.data.get('typing', {})
            ).affectedKeys().hasOnly([request.auth.uid]);
      }

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants;

      allow read: if isParticipant();

      // Metadata percakapan, typing indicator, dan blokir.
      // Peserta tidak boleh mengganti daftar peserta.
      allow update: if isParticipant()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participants', 'productId', 'productTitle',
          'lastMessage', 'lastMessageAt', 'updatedAt',
          'typing', 'blockedBy'
        ])
        && typingUpdateIsOwn()
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'blockedBy'
          ])
          || (
            request.resource.data.get('blockedBy', []) is list
            && (
              (
                request.resource.data.get('blockedBy', [])
                  .hasAll(resource.data.get('blockedBy', []))
                && request.auth.uid in request.resource.data.get('blockedBy', [])
              )
              || (
                resource.data.get('blockedBy', []).hasAll(
                  request.resource.data.get('blockedBy', [])
                )
                && resource.data.get('blockedBy', []).toSet()
                  .difference(request.resource.data.get('blockedBy', []).toSet())
                  .hasOnly([request.auth.uid])
              )
            )
          )
        );

      allow delete: if false;

      match /messages/{messageId} {

        function chatData() {
          return get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data;
        }

        function isChatParticipant() {
          return signedIn()
            && request.auth.uid in chatData().participants;
        }

        function chatIsNotBlocked() {
          return !chatData().get('blockedBy', [])
            .hasAny(chatData().participants);
        }

        allow read: if isChatParticipant();

        // Mendukung pesan teks, emoji, foto, dan voice note.
        // Untuk foto/audio, text boleh kosong selama mediaUrl tersedia.
        allow create: if isChatParticipant()
          && platformEnabled('chatEnabled')
          && get(/databases/$(database)/documents/app_config/platform).data.get('maintenanceMode', false) == false
          && chatIsNotBlocked()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'type', 'mediaUrl', 'durationMs',
            'createdAt', 'deliveredTo', 'readBy'
          ])
          && request.resource.data.type in ['text', 'image', 'audio']
          && request.resource.data.text is string
          && (
            (
              request.resource.data.type == 'text'
              && request.resource.data.text.size() > 0
            )
            || (
              request.resource.data.type in ['image', 'audio']
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() > 0
            )
          )
          && (
            !request.resource.data.keys().hasAny(['durationMs'])
            || (
              request.resource.data.type == 'audio'
              && request.resource.data.durationMs is number
              && request.resource.data.durationMs >= 0
              && request.resource.data.durationMs <= 3600000
            )
          )
          && request.resource.data.deliveredTo is list
          && request.auth.uid in request.resource.data.deliveredTo
          && request.resource.data.readBy is list
          && request.auth.uid in request.resource.data.readBy;

        // Status diterima/dibaca dan reaksi emoji.
        // Pengguna hanya boleh menambahkan UID miliknya ke receipt,
        // dan hanya boleh mengubah reaksinya sendiri.
        allow update: if isChatParticipant()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deliveredTo', 'readBy', 'reactions', 'updatedAt'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'deliveredTo'
            ])
            || (
              request.resource.data.deliveredTo is list
              && request.resource.data.deliveredTo.toSet()
                .difference(resource.data.get('deliveredTo', []).toSet())
                .hasOnly([request.auth.uid])
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'readBy'
            ])
            || (
              request.resource.data.readBy is list
              && request.resource.data.readBy.toSet()
                .difference(resource.data.get('readBy', []).toSet())
                .hasOnly([request.auth.uid])
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'reactions'
            ])
            || (
              request.resource.data.reactions is map
              && request.resource.data.reactions
                .diff(resource.data.get('reactions', {}))
                .affectedKeys()
                .hasOnly([request.auth.uid])
              && request.resource.data.reactions.get(request.auth.uid, '') is string
              && request.resource.data.reactions.get(request.auth.uid, '').size() <= 8
            )
          );

        allow delete: if false;
      }
    }

    // ==============================
    // GRUP KOMUNITAS & PESAN GRUP
    // ==============================

    match /groups/{groupId} {
      function isGroupMember() {
        return signedIn() && request.auth.uid in resource.data.get('members', []);
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'name', 'description', 'ownerId', 'members',
          'memberCount', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 50
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.memberCount == 1;

      allow update: if signedIn()
        && (
          (
            resource.data.ownerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'description', 'updatedAt'
            ])
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 3
            && request.resource.data.name.size() <= 50
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 240
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'members', 'memberCount'
            ])
            && request.resource.data.members is list
            && request.resource.data.memberCount <= 5000
            && (
              (
                request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 1
                && request.resource.data.members.toSet().difference(resource.data.members.toSet()).hasOnly([request.auth.uid])
                && resource.data.members.toSet().difference(request.resource.data.members.toSet()).size() == 0
                && request.resource.data.memberCount == resource.data.memberCount + 1
              )
              || (
                resource.data.members.toSet().difference(request.resource.data.members.toSet()).size() == 1
                && resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid])
                && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0
                && request.resource.data.memberCount == resource.data.memberCount - 1
              )
            )
          )
          || (
            isGroupMember()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessage', 'lastMessageAt'
            ])
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() <= 500
          )
        );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /messages/{messageId} {
        function parentGroup() {
          return get(/databases/$(database)/documents/groups/$(groupId)).data;
        }

        function memberCanRead() {
          return signedIn() && request.auth.uid in parentGroup().members;
        }

        allow read: if memberCanRead();

        allow create: if memberCanRead()
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'text', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }
    }

    // ==============================
    // FOLLOW / IKUTI PENGGUNA
    // ==============================

    match /user_follows/{followId} {
      // Data follow hanya berisi dua UID; boleh dibaca pengguna login
      // agar tombol Ikuti dapat memeriksa status dokumen yang belum ada.
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['followerId', 'followingId', 'createdAt'])
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followingId;

      allow delete: if signedIn()
        && resource.data.followerId == request.auth.uid;

      allow update: if false;
    }

    // ==============================
    // KOMUNITAS / POSTINGAN
    // ==============================

    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && maintenanceIsOff()
        && request.resource.data.keys().hasOnly([
          'ownerId', 'ownerName', 'ownerPhoto', 'text', 'imageUrls',
          'likes', 'commentCount', 'shareCount', 'createdAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 80
        && request.resource.data.ownerPhoto is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 4
        && (request.resource.data.text.size() > 0 || request.resource.data.imageUrls.size() > 0)
        && request.resource.data.likes is list
        && request.resource.data.likes.size() == 0
        && request.resource.data.commentCount == 0
        && request.resource.data.shareCount == 0;

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'likes', 'commentCount', 'shareCount'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes'])
          || (
            request.resource.data.likes is list
            && request.resource.data.likes.toSet().difference(resource.data.get('likes', []).toSet()).hasOnly([request.auth.uid])
            && resource.data.get('likes', []).toSet().difference(request.resource.data.likes.toSet()).hasOnly([request.auth.uid])
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['commentCount'])
          || request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['shareCount'])
          || request.resource.data.shareCount == resource.data.get('shareCount', 0) + 1
        );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow delete: if isAdmin()
          || (signedIn() && resource.data.uid == request.auth.uid);
        allow update: if false;
      }
    }

    // ==============================
    // BLOKIR PENGGUNA
    // ==============================

    match /user_blocks/{blockId} {
      allow read: if signedIn()
        && resource.data.blockerId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid;

      allow delete: if signedIn()
        && resource.data.blockerId == request.auth.uid;

      allow update: if false;
    }

    // ==============================
    // CUSTOMER SERVICE / CHAT ADMIN
    // ==============================

    match /support_threads/{threadId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || hasPermission('chat')
        );

      allow update: if signedIn()
        && (
          hasPermission('chat')
          || (
            resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
          )
        );

      allow delete: if hasPermission('chat');

      match /messages/{messageId} {
        function canUseThread() {
          return signedIn()
            && (
              get(
                /databases/$(database)/documents/support_threads/$(threadId)
              ).data.userId == request.auth.uid
              || hasPermission('chat')
            );
        }

        allow read: if canUseThread();

        allow create: if canUseThread()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;

        allow update, delete: if false;
      }
    }

    // ==============================
    // MARKETPLACE ORDERS & WALLET LEDGER
    // All financial/order writes are server-only via Cloud Functions.
    // ==============================

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || hasPermission('orders')
          || hasPermission('disputes'));

      // Pembeli hanya boleh membuat pesanan COD yang cocok dengan data produk.
      // Pembuatan order dan pengurangan stok wajib berada dalam satu transaksi.
      allow create: if signedIn()
        && maintenanceIsOff()
        && platformEnabled('ordersEnabled')
        && platformEnabled('codEnabled')
        && request.resource.data.keys().hasOnly([
          'orderId', 'buyerId', 'sellerId', 'productId', 'productTitle',
          'productImage', 'quantity', 'unitPrice', 'subtotal', 'serviceFee',
          'total', 'paymentMethod', 'paymentStatus', 'deliveryMethod',
          'deliveryAddress', 'note', 'status', 'createdAt', 'updatedAt',
          'statusHistory'
        ])
        && request.resource.data.orderId == orderId
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 99
        && request.resource.data.paymentMethod == 'cod'
        && request.resource.data.paymentStatus == 'pay_on_delivery'
        && request.resource.data.serviceFee == 0
        && request.resource.data.total == request.resource.data.subtotal
        && request.resource.data.status == 'awaiting_confirmation'
        && request.resource.data.productId is string
        && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.status == 'active'
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.sellerId == request.resource.data.sellerId
        && request.resource.data.sellerId != request.auth.uid
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.price == request.resource.data.unitPrice
        && request.resource.data.subtotal == request.resource.data.unitPrice * request.resource.data.quantity
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.stock >= request.resource.data.quantity
        && (
          request.resource.data.deliveryMethod == 'meetup'
          || (
            request.resource.data.deliveryMethod == 'delivery'
            && request.resource.data.deliveryAddress is string
            && request.resource.data.deliveryAddress.size() >= 8
          )
        )
        && getAfter(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.stock
          == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.stock - request.resource.data.quantity
        && getAfter(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.lastOrderId == orderId;

      allow update, delete: if false;
    }

    match /order_cases/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || hasPermission('orders')
          || hasPermission('disputes'));
      allow create, update, delete: if false;
    }

    match /wallets/{userId} {
      allow read: if isOwner(userId) || hasPermission('finance');
      allow create, update, delete: if false;
    }

    match /wallet_transactions/{transactionId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || hasPermission('finance'));
      allow create, update, delete: if false;
    }

    // ==============================
    // CLIENT FAILURE LOGS
    // ==============================

    match /client_error_logs/{logId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'message', 'stack', 'source', 'platform', 'createdAt'
        ]);
      allow read: if hasPermission('system');
      allow update, delete: if false;
    }

    // ==============================
    // ADMIN AUDIT LOGS
    // ==============================

    match /admin_audit_logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ==============================
    // DEFAULT: TOLAK AKSES LAINNYA
    // ==============================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}