rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USERS / PROFIL PRIVAT
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user';

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'phone', 'photoUrl', 'location', 'updatedAt'
          ])
        );

      allow delete: if isAdmin();

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }

      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }
    }

    // PROFIL PUBLIK MINIMAL UNTUK NAMA/FOTO/PRESENCE CHAT
    match /public_profiles/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoUrl', 'isOnline', 'lastSeen', 'updatedAt'
        ]);
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoUrl', 'isOnline', 'lastSeen', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // PRODUK / IKLAN
    match /products/{productId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.price is number;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'price', 'imageUrl', 'imageUrls',
            'category', 'locationName', 'latitude', 'longitude',
            'status', 'updatedAt'
          ])
        )
        || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
          && request.resource.data.get('reportCount', 0)
            == resource.data.get('reportCount', 0) + 1
        );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.sellerId == request.auth.uid);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // LAPORAN IKLAN / PENGGUNA
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reason is string
        && (
          request.resource.data.get('productId', '') is string
          || (
            request.resource.data.get('targetUserId', '') is string
            && request.resource.data.get('chatId', '') is string
          )
        );

      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // CHAT PEMBELI - PENJUAL
    match /chats/{chatId} {
      function isParticipant() {
        return signedIn()
          && request.auth.uid in resource.data.participants;
      }

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants;

      allow read: if isParticipant();

      // Mengizinkan update metadata, status mengetik, dan blokir.
      // Peserta hanya boleh menambahkan dirinya sendiri ke blockedBy.
      allow update: if isParticipant()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participants', 'productId', 'productTitle', 'lastMessage',
          'lastMessageAt', 'updatedAt', 'typing', 'blockedBy'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['blockedBy'])
          || (
            request.resource.data.get('blockedBy', []) is list
            && request.resource.data.get('blockedBy', []).hasAll(
              resource.data.get('blockedBy', [])
            )
            && request.auth.uid in request.resource.data.get('blockedBy', [])
          )
        );

      allow delete: if false;

      match /messages/{messageId} {
        function chatData() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        function isChatParticipant() {
          return signedIn()
            && request.auth.uid in chatData().participants;
        }

        allow read: if isChatParticipant();

        // Pesan teks, emoji, foto, dan voice note.
        // Foto/voice note boleh memiliki text kosong selama mediaUrl tersedia.
        allow create: if isChatParticipant()
          && chatData().get('blockedBy', []).size() == 0
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'type', 'mediaUrl',
            'createdAt', 'deliveredTo', 'readBy'
          ])
          && request.resource.data.type in ['text', 'image', 'audio']
          && request.resource.data.text is string
          && (
            (
              request.resource.data.type == 'text'
              && request.resource.data.text.size() > 0
            )
            || (
              request.resource.data.type in ['image', 'audio']
              && request.resource.data.mediaUrl is string
              && request.resource.data.mediaUrl.size() > 0
            )
          )
          && request.resource.data.deliveredTo is list
          && request.auth.uid in request.resource.data.deliveredTo
          && request.resource.data.readBy is list
          && request.auth.uid in request.resource.data.readBy;

        // Tanda diterima/dibaca dan reaksi emoji pada pesan.
        allow update: if isChatParticipant()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deliveredTo', 'readBy', 'reactions', 'updatedAt'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['readBy'])
            || (
              request.resource.data.readBy is list
              && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
              && request.auth.uid in request.resource.data.readBy
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveredTo'])
            || (
              request.resource.data.deliveredTo is list
              && request.resource.data.deliveredTo.hasAll(resource.data.get('deliveredTo', []))
              && request.auth.uid in request.resource.data.deliveredTo
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactions'])
            || (
              request.resource.data.reactions is map
              && request.resource.data.reactions.get(request.auth.uid, '') is string
              && request.resource.data.reactions.get(request.auth.uid, '').size() <= 8
            )
          );

        allow delete: if false;
      }
    }

    // BLOKIR PENGGUNA
    match /user_blocks/{blockId} {
      allow read: if signedIn() && resource.data.blockerId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid;

      allow delete: if signedIn() && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // CUSTOMER SERVICE
    match /support_threads/{threadId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());

      allow update: if signedIn()
        && (
          isAdmin()
          || (
            resource.data.userId == request.auth.uid
            && request.resource.data.userId == resource.data.userId
          )
        );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function canUseThread() {
          return signedIn()
            && (
              get(/databases/$(database)/documents/support_threads/$(threadId)).data.userId == request.auth.uid
              || isAdmin()
            );
        }

        allow read: if canUseThread();

        allow create: if canUseThread()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0;

        allow update, delete: if false;
      }
    }

    // DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }
  }
}